# Provider: ollama (default). Future: claude, openai, azure
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Future Claude adapter (unused until implemented)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-20250514

# CORS — frontend origin
CORS_ORIGINS=http://localhost:3000

# Set true to skip LLM and return hardcoded AnalyzeResponse
ANALYZE_STUB=false

# Skill matching thresholds (Day 2)
MATCH_THRESHOLD=0.85
REVIEW_THRESHOLD=0.65
MATCHING_USE_ARBITER=true
